if ROCKCHIP_RK3576

config TARGET_KICKPI_K7_RK3576
	bool "KICKPI K7 N-Boot downstream"
	select LINUX_KERNEL_IMAGE_HEADER
	help
	  Enable the KICKPI K7 N-Boot board contract, including the native
	  ARM64 Image header required by the vendor BL31 boot chain.

config NBOOT_FASTBOOT
	bool "N-Boot controlled USB recovery"
	depends on TARGET_KICKPI_K7_RK3576 && USB_GADGET
	select USB_FUNCTION_FASTBOOT
	select FASTBOOT_OEM_BOARD
	help
	  Enable verified NuttX A/B and N-Boot updates. Generic
	  partition writes require a short-lived two-command confirmation.
	  Erase and arbitrary command execution stay disabled.

config TARGET_ROC_PC_RK3576
	bool "Firefly ROC-RK3576-PC"
	help
	  ROC-RK3576-PC is a single board computer from Firefly
	  using the Rockchip RK3576.

config ROCKCHIP_BOOT_MODE_REG
	default 0x26024040

config ROCKCHIP_STIMER_BASE
	default 0x27400000

config SYS_SOC
	default "rk3576"

source board/firefly/roc-pc-rk3576/Kconfig

config SYS_CONFIG_NAME
	default "rk3576_common"

endif
